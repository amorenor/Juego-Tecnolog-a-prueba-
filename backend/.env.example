# ─────────────────────────────────────────────────────
# Mi Equipo AquaChile – Configuración del Backend
# Copia este archivo como .env y completa los valores
# ─────────────────────────────────────────────────────

# ── BASE DE DATOS ─────────────────────────────────────
#
# Opción A: MongoDB Atlas (gratuito)
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/aquachile_team?retryWrites=true&w=majority&appName=Cluster0
#
# Opción B: Azure Cosmos DB for MongoDB
# MONGODB_URI=mongodb+srv://<cuenta>:<key>@<cuenta>.mongocluster.cosmos.azure.com/aquachile_team?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
#
# Opción C: MongoDB local (desarrollo)
MONGODB_URI=mongodb://localhost:27017/aquachile_team

# ── SEGURIDAD ─────────────────────────────────────────
# Genera un secreto seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro_en_produccion

# Duración de la sesión (8h = jornada laboral)
JWT_EXPIRES_IN=8h

# Si rotaste el JWT_SECRET, pon aquí el unix timestamp desde el cual los tokens son válidos
# Genera con: node -e "console.log(Math.floor(Date.now()/1000))"
# JWT_NOT_BEFORE=

# ── SERVIDOR ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────
# En producción reemplaza con tu dominio real (sin / al final)
# Puedes separar múltiples orígenes con coma:
# CORS_ORIGIN=https://appgerencia.aquachile.com,https://www.appgerencia.aquachile.com
CORS_ORIGIN=http://localhost:3000

# ── MICROSOFT ENTRA ID (completar cuando TI entregue los datos) ───────────────
# ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ENTRA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
