# ─────────────────────────────────────────────────────
# Mi Equipo AquaChile – Configuración del Backend
# Copia este archivo como .env y completa los valores
# ─────────────────────────────────────────────────────

# ── BASE DE DATOS ─────────────────────────────────────
#
# Opción A: MongoDB Atlas (gratuito)
#   1. Crea cuenta en https://www.mongodb.com/atlas/database
#   2. Crea un cluster Free Tier (M0)
#   3. En "Connect" > "Drivers" copia la URI de conexión
#
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/aquachile_team?retryWrites=true&w=majority&appName=Cluster0
#
# Opción B: Azure Cosmos DB for MongoDB
#   1. Crea recurso "Azure Cosmos DB for MongoDB" en el portal
#   2. En "Connection strings" copia la cadena de conexión
#
# MONGODB_URI=mongodb+srv://<cuenta>:<key>@<cuenta>.mongocluster.cosmos.azure.com/aquachile_team?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
#
# Opción C: MongoDB local (desarrollo)
MONGODB_URI=mongodb://localhost:27017/aquachile_team

# ── SEGURIDAD ─────────────────────────────────────────
# Cambia este valor por un string aleatorio largo en producción
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro_en_produccion

# Duración de la sesión (8h = 8 horas de trabajo)
JWT_EXPIRES_IN=8h

# ── SERVIDOR ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────
# URL del frontend (en dev: Vite dev server)
CORS_ORIGIN=http://localhost:3000
